{
  "manifest_version": 3,
  "name": "WhatsApp AI Chat Bot",
  "version": "1.0.0",
  "description": "Automatic AI-powered chatbot for WhatsApp Web using Gemini API",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp AI Bot"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}